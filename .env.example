# Copia para .env e preenche (nunca faças commit do .env)
JWT_SECRET=muda-isto-para-uma-frase-longa-e-aleatoria
PORT=3001
APP_URL=http://localhost:5173

# Email. Sem SMTP_HOST, os emails só aparecem na consola do servidor (modo teste).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Rastreador de Gastos <o-teu-email@exemplo.pt>
